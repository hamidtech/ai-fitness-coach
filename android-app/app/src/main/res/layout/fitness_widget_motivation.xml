<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="top|start"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fitness_coach" />
        <TextView
            android:id="@+id/widget_heading"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_today"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|start"
        android:minHeight="32dp"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_quick_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="4dp"
        android:minHeight="48dp"
        android:paddingHorizontal="6dp"
        android:background="@drawable/widget_start_background"
        android:fontFamily="sans-serif-medium"
        android:text="@string/widget_start"
        android:textColor="@color/widget_action_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="4"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_ink"
        android:textDirection="ltr"
        android:textSize="13sp"
        android:text="@string/widget_motivation_label" />
</LinearLayout>
